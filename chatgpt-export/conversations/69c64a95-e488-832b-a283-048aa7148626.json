    "e05e9868-c49a-4874-9dc1-e986cebcca9b": {
      "id": "e05e9868-c49a-4874-9dc1-e986cebcca9b",
      "message": {
        "id": "e05e9868-c49a-4874-9dc1-e986cebcca9b",
        "author": {
          "role": "assistant",
