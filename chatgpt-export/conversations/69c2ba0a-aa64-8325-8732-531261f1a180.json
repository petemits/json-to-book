    "6ad1c9ba-fd26-4d08-a4e2-08ecc5d8721d": {
      "id": "6ad1c9ba-fd26-4d08-a4e2-08ecc5d8721d",
      "message": {
        "id": "6ad1c9ba-fd26-4d08-a4e2-08ecc5d8721d",
        "author": {
          "role": "assistant",
