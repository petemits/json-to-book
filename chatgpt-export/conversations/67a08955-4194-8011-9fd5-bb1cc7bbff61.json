    "7d7c2f8f-15a3-46ed-aea5-635cdac916ae": {
      "id": "7d7c2f8f-15a3-46ed-aea5-635cdac916ae",
      "message": {
        "id": "7d7c2f8f-15a3-46ed-aea5-635cdac916ae",
        "author": {
          "role": "assistant",
          "name": null,
          "metadata": {}
