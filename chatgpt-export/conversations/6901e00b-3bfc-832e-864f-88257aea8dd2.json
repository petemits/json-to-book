    "bdc399f1-22be-47e7-890b-f593fa9bb9e7": {
      "id": "bdc399f1-22be-47e7-890b-f593fa9bb9e7",
      "message": {
        "id": "bdc399f1-22be-47e7-890b-f593fa9bb9e7",
        "author": {
          "role": "assistant",
          "name": null,
          "metadata": {}
