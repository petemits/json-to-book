    "a4dfa56e-0777-40d5-9f9c-5a1fdb4eb49c": {
      "id": "a4dfa56e-0777-40d5-9f9c-5a1fdb4eb49c",
      "message": {
        "id": "a4dfa56e-0777-40d5-9f9c-5a1fdb4eb49c",
        "author": {
          "role": "assistant",
