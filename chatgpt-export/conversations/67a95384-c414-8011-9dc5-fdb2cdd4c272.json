    "5d3b934d-6a11-4701-8d49-5996b6356fdf": {
      "id": "5d3b934d-6a11-4701-8d49-5996b6356fdf",
      "message": {
        "id": "5d3b934d-6a11-4701-8d49-5996b6356fdf",
        "author": {
          "role": "assistant",
