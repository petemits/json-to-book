    "724eb4e8-977a-4caa-881e-70401e9ea3d8": {
      "id": "724eb4e8-977a-4caa-881e-70401e9ea3d8",
      "message": {
        "id": "724eb4e8-977a-4caa-881e-70401e9ea3d8",
        "author": {
          "role": "assistant",
