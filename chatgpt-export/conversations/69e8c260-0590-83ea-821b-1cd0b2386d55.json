    "8495d198-2b2d-40c4-b5ce-ef12c5b4ba86": {
      "id": "8495d198-2b2d-40c4-b5ce-ef12c5b4ba86",
      "message": {
        "id": "8495d198-2b2d-40c4-b5ce-ef12c5b4ba86",
        "author": {
          "role": "assistant",
          "name": null,
