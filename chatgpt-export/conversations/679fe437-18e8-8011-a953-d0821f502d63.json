    "7365fd13-69dd-4755-ac78-0eeba0ea7891": {
      "id": "7365fd13-69dd-4755-ac78-0eeba0ea7891",
      "message": {
        "id": "7365fd13-69dd-4755-ac78-0eeba0ea7891",
        "author": {
          "role": "assistant",
